AWS_ACCESS_KEY_ID=aws_access_key_id
AWS_ACCESS_SECRET=aws_access_secret

# S3-compatible gateway (versitygw). The gateway resolves the bucket from the
# Host header and treats the request path as the key, so objects are served at
# https://<bucket>.<endpoint host>/<key> -- AWS_S3_ENDPOINT is therefore the
# PARENT domain, and the bucket name doubles as the host label.
AWS_S3_ENDPOINT=https://gravity.ph
AWS_S3_BUCKET=static-dev
# Public bucket: served anonymously, no presigned URLs. Blog media and profile
# photos live here, so their URLs are stable and safe to embed in stored HTML.
# With virtual-host addressing its public host is <bucket>.<endpoint host>.
AWS_S3_PUBLIC_BUCKET=static-public
AWS_S3_PUBLIC_HOST=static-dev.gravity.ph
AWS_S3_REGION=us-east-1

# false = virtual-host addressing (bucket from Host, path is the key).
# Do not set this to true against this gateway: requests would go to
# /<bucket>/<key> and the bucket segment would be stored as part of the key.
AWS_S3_FORCE_PATH_STYLE=false

DB_URL=postgres://user:password@host:port/databse
PORT=16000
RACK_ENV=production
SECRET_KEY_BASE=secretkey

SENDGRID_USERNAME=user
SENDGRID_API_KEY=sendgrid_api_key
INTERCEPT_RECIPIENT=user@example.com

DB_PORT=5432
